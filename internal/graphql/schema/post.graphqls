type Post {
  id: ID!
  groupID: ID
  textContent: String
  picturesAttached: [String!]
  createdAt: String!
  updatedAt: String!
}

input CreatePostInput {
  groupID: ID
  textContent: String
  picturesAttached: [String!]
}

input UpdatePostInput {
  textContent: String
  picturesAttached: [String!]
}

extend type Query {
  post(id: ID!): Post
  myPosts: [Post!]
}

extend type Mutation {
  createPost(input: CreatePostInput!): Post!
  updatePost(id: ID!, input: UpdatePostInput!): Post!
}
