type UserData {
  lastSeen: String
  followers: [String!]
  followings: [String!]
}

input UpdateUserDataInput {
  lastSeen: String
  followers: [String!]
  followings: [String!]
}

extend type Query {
  myUserData: UserData
}

extend type Mutation {
  updateMyUserData(input: UpdateUserDataInput!): UserData!
}
