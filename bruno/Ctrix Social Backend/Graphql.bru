meta {
  name: Graphql
  type: graphql
  seq: 3
}

post {
  url: http://localhost:4000/query
  body: graphql
  auth: inherit
}

body:graphql {
  query {
    myUserProfile {
      firstName
      lastName
    }
    myUserData {
      followers
      followings
    }
    myUserSetting {
      showOnline
      blockUser
    }
  }
  
}

settings {
  encodeUrl: true
}
